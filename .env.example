SUPPORT_DATA_DIR=data/runtime
SUPPORT_AUTOMATION_PROVIDER=local
SUPPORT_AGENT_PROVIDER=deterministic
SUPPORT_DEPLOYMENT_MODE=development
SUPPORT_APPROVAL_ARR_THRESHOLD=25000
SUPPORT_NOTIFICATION_WEBHOOK_URL=
SUPPORT_OUTBOUND_ALLOWED_HOSTS=
SUPPORT_OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
SUPPORT_OUTBOUND_CONNECT_TIMEOUT_SECONDS=2
SUPPORT_OUTBOUND_READ_TIMEOUT_SECONDS=5
SUPPORT_OUTBOUND_IDEMPOTENCY_HEADER=Idempotency-Key
SUPPORT_OUTBOUND_SECRET_REF=
SUPPORT_OUTBOUND_SECRET_HEADER=Authorization
SUPPORT_OUTBOUND_REQUEST_REDACTED_FIELDS=customer_name,token,secret,authorization
SUPPORT_OUTBOUND_RESPONSE_REDACTED_FIELDS=token,secret,authorization
# MCP defaults to a credential-free stdio/loopback-only development server.
SUPPORT_MCP_HOST=127.0.0.1
SUPPORT_MCP_PORT=8001
SUPPORT_MCP_HTTP_PATH=/mcp
SUPPORT_MCP_ALLOW_NETWORK=false
SUPPORT_MCP_ALLOWED_HOSTS=
SUPPORT_MCP_ALLOWED_ORIGINS=
SUPPORT_MCP_AUTH_MODE=none
# Static bearer mode uses an env:NAME reference; the resolved token is never returned.
SUPPORT_MCP_AUTH_TOKEN_REF=
SUPPORT_MCP_ISSUER_URL=https://identity.example
SUPPORT_MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8001/mcp
SUPPORT_MCP_REQUIRED_SCOPES=relay:tools
SUPPORT_MCP_MAX_REQUEST_BODY_BYTES=1048576
SUPPORT_LLM_BASE_URL=
SUPPORT_LLM_API_KEY=
SUPPORT_LLM_MODEL=
