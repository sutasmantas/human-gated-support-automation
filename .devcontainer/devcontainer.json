{
  "name": "AI Support Desk",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e '.[dev]'",
  "postStartCommand": "nohup uvicorn support_desk.main:app --host 0.0.0.0 --port 8000 > /tmp/support-desk.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AI Support Desk",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
